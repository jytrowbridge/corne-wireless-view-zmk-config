#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// outstanding:
// bluetooth
// one-shot mods on base

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";
                        bindings = <
   &kp LGUI   &kp Q       &kp W       &kp F        &kp P        &kp B          &kp J      &kp L       &kp U       &kp Y        &kp BSPC     &kp DEL
   &sk LCTRL  &mt LGUI A  &mt LALT R  &mt LSHFT S  &mt LCTRL T  &kp G          &kp M      &mt RGUI N  &mt RALT E  &mt RSHFT I  &mt RCTRL O  &kp SQT
   &sk LSHFT  &kp Z       &kp X       &kp C        &kp D        &kp V          &kp K      &kp H       &kp COMMA   &kp DOT      &kp FSLH     &sk RSHIFT
                                      &lt 6 ESC    &lt 4 SPACE  &lt 5 TAB      &lt 2 RET  &lt 1 BSPC  &lt 3 DEL
                        >;
                };

                num_layer {
                        display-name = "Num";
                        bindings = <
   &trans  &kp STAR   &kp N7  &kp N8  &kp N9  &kp KP_PLUS       &kp N6  &kp N7     &kp N8      &KP N9    &KP N0    &trans
   &trans  &kp PRCNT  &kp N4  &kp N5  &kp N6  &kp KP_EQUAL      &trans  &kp RCTRL  &kp RSHIFT  &kp RALT  &kp RGUI  &trans
   &trans  &kp FSLH   &kp N1  &kp N2  &kp N3  &kp KP_MINUS      &kp N1  &kp N2     &kp N3      &KP N4    &KP N5    &trans
                              &trans  &kp N0  &trans            &trans  &trans     &trans
                        >;
                };
                
                sym_layer {
                        display-name = "Sym";
                        bindings = <
   &trans  &kp GRAVE   &kp LBKT     &kp AMPS   &kp RBKT     &kp FSLH       &trans   &trans     &trans      &trans    &trans    &trans
   &trans  &kp DOLLAR  &kp KP_LPAR  &kp EXCL   &kp KP_RPAR  &kp BSLH       &trans   &kp RCTRL  &kp RSHIFT  &kp RALT  &kp RGUI  &trans
   &trans  &kp POUND   &kp STAR     &kp AT     &kp PRCNT    &kp CARET      &trans   &trans     &trans      &trans    &trans    &trans
                                    &kp MINUS  &kp EQUAL    &kp SEMI       &trans   &trans     &trans
                        >;
                };

                fun_layer {
                        display-name = "Fun";
                        bindings = <
   &trans  &trans &kp F7   &kp F8   &kp F9   &kp F10      &trans  &kp PSCRN  &kp INS     &trans    &trans    &trans
   &trans  &trans &kp F4   &kp F5   &kp F6   &kp F11      &trans  &kp RCTRL  &kp RSHIFT  &kp RALT  &kp RGUI  &trans
   &trans  &trans &kp F1   &kp F2   &kp F3   &kp F12      &trans  &trans     &trans      &trans    &trans    &trans
                           &mo 7    &trans   &trans       &trans  &trans     &trans
                        >;
                };

                nav_layer {
                        display-name = "Nav";
                        bindings = <
   &trans  &trans    &trans     &kp LC(LS(LEFT))  &kp LC(LS(RIGHT))  &trans      &trans    &kp HOME   &kp END    &trans     &trans  &kp BSPC
   &trans  &kp LGUI  &kp LCTRL  &kp LSHFT         &kp LALT           &trans      &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
   &trans  &trans    &trans     &trans            &trans             &trans      &trans    &kp PG_DN  &kp PG_UP  &trans     &trans  &trans
                                &trans            &trans             &trans      &trans    &kp HOME   &kp END
                        >;
                };

                mouse_layer {
                        display-name = "Mouse";
                        bindings = <
   &tog 5  &trans   &trans     &trans     &trans     &trans      &trans          &trans          &trans        &trans           &trans  &trans
   &trans  &trans   &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
   &trans  &trans   &trans     &trans     &trans     &trans      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &trans
                               &trans     &trans     &trans      &mkp RCLK       &mkp LCLK      &mkp MCLK
                        >;
                };


                media_layer {
                        display-name = "Media";
                        bindings = <
   &trans  &trans   &trans      &kp K_NEXT      &kp K_PREV        &trans          &trans      &kp K_PREV        &kp K_NEXT        &trans      &trans  &trans
   &trans  &trans   &kp K_MUTE  &kp C_VOL_DN    &kp C_VOL_UP      &trans          &trans      &kp C_VOL_UP      &kp C_VOL_DN      &kp K_MUTE  &trans  &trans
   &trans  &trans   &trans      &trans          &kp K_PLAY_PAUSE  &trans          &trans      &trans            &kp K_PLAY_PAUSE  &trans      &trans  &trans
                                &trans          &trans            &trans          &kp C_STOP  &kp K_PLAY_PAUSE  &trans
                        >;
                };

                bluetooth_layer {
                        display-name = "Bluetooth";
                        bindings = <
   &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &bt BT_CLR
   &trans  &trans  &trans  &trans  &trans  &trans      &trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5
   &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
                           &trans  &trans  &trans      &trans  &trans        &trans
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
