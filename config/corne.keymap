#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// outstanding:
// bluetooth
// one-shot mods on base

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";
                        bindings = <
   &kp LGUI   &kp Q       &kp W       &kp F        &kp P        &kp B          &kp J      &kp L        &kp U        &kp Y       &kp BSPC    &kp DEL
   &sk LCTRL  &mt LGUI A  &mt LALT R  &mt LSHFT S  &mt LCTRL T  &kp G          &kp M      &mt RCTRL N  &mt RSHFT E  &mt RALT I  &mt RGUI O  &kp SQT
   &sk LSHFT  &kp Z       &kp X       &kp C        &kp D        &kp V          &kp K      &kp H        &kp COMMA    &kp DOT     &kp FSLH    &sk RSHIFT
                                      &lt 6 ESC    &lt 4 SPACE  &lt 5 TAB      &lt 2 RET  &lt 1 BSPC  &lt 3 DEL
                        >;
                };

                num_layer {
                        display-name = "Num";
                        bindings = <
   &trans  &kp STAR   &kp N7  &kp N8  &kp N9  &kp KP_PLUS       &kp N6  &kp N7     &kp N8      &kp N9    &kp  N0    &trans
   &trans  &kp PRCNT  &kp N4  &kp N5  &kp N6  &kp KP_EQUAL      &none   &kp RCTRL  &kp RSHIFT  &kp RALT  &kp  RGUI  &trans
   &trans  &kp FSLH   &kp N1  &kp N2  &kp N3  &kp KP_MINUS      &kp N1  &kp N2     &kp N3      &kp N4    &kp  N5    &trans
                              &trans  &kp N0  &trans            &trans  &trans     &trans
                        >;
                };
                
                sym_layer {
                        display-name = "Sym";
                        bindings = <
   &trans  &kp GRAVE   &kp LBKT     &kp AMPS   &kp RBKT     &kp FSLH       &none   &none      &none       &none     &none     &none
   &trans  &kp DOLLAR  &kp KP_LPAR  &kp EXCL   &kp KP_RPAR  &kp BSLH       &none   &kp RCTRL  &kp RSHIFT  &kp RALT  &kp RGUI  &none
   &trans  &kp POUND   &kp STAR     &kp AT     &kp PRCNT    &kp CARET      &none   &none      &none       &none     &none     &none
                                    &kp MINUS  &kp EQUAL    &kp SEMI       &trans   &trans     &trans
                        >;
                };

                fun_layer {
                        display-name = "Fun";
                        bindings = <
   &trans  &none &kp F7   &kp F8   &kp F9   &kp F10      &none  &kp PSCRN  &kp INS     &none     &none     &none
   &trans  &none &kp F4   &kp F5   &kp F6   &kp F11      &none  &kp RCTRL  &kp RSHIFT  &kp RALT  &kp RGUI  &none
   &trans  &none &kp F1   &kp F2   &kp F3   &kp F12      &none  &none      &none       &none     &none     &none
                           &mo 7   &none    &none        &none  &none      &none
                        >;
                };

                nav_layer {
                        display-name = "Nav";
                        bindings = <
   &trans  &none     &none      &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &none      &none     &kp HOME   &kp END    &none      &none  &kp BSPC
   &trans  &kp LGUI  &kp LCTRL  &kp LSHFT         &kp LALT           &none      &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none  &none
   &trans  &none     &none      &none             &none              &none      &none     &kp PG_DN  &kp PG_UP  &none      &none  &none
                                &none             &none              &none      &none     &kp HOME   &kp END
                        >;
                };

                mouse_layer {
                        display-name = "Mouse";
                        bindings = <
   &tog 5  &none   &none      &none      &none      &none      &none           &none           &none         &none            &none  &none
   &trans  &none   &mkp RCLK  &mkp MCLK  &mkp LCLK  &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
   &trans  &none   &none      &none      &none      &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
                              &none      &none      &none      &mkp RCLK       &mkp LCLK       &mkp MCLK
                        >;
                };


                media_layer {
                        display-name = "Media";
                        bindings = <
   &trans  &none   &none       &kp K_NEXT      &kp K_PREV        &none          &none       &kp K_PREV        &kp K_NEXT        &none       &none  &none
   &trans  &none   &kp K_MUTE  &kp C_VOL_DN    &kp C_VOL_UP      &none          &none       &kp C_VOL_UP      &kp C_VOL_DN      &kp K_MUTE  &none  &none
   &trans  &none   &none       &none           &kp K_PLAY_PAUSE  &none          &none       &none             &kp K_PLAY_PAUSE  &none       &none  &none
                                &none          &none             &none          &kp C_STOP  &kp K_PLAY_PAUSE  &none
                        >;
                };

                bluetooth_layer {
                        display-name = "Bluetooth";
                        bindings = <
   &none  &none  &none  &none  &none  &none      &none  &none         &none         &none         &none         &bt BT_CLR
   &none  &none  &none  &none  &none  &none      &none  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5
   &none  &none  &none  &none  &none  &none      &none  &none         &none         &none         &none         &none
                        &none  &none  &none      &none  &none         &none
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
