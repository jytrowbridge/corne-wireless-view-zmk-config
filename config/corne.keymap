#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// outstanding:
// function
// symbols
// bluetooth
// media
// gresc
// macros-- maybe just use modifier functions
// one-shot mods on base?

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        display-name = "Base";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp F &kp P &kp B   &kp J &kp L  &kp U     &kp Y   &kp BSPC    &kp DEL
   &kp LCTRL &kp A &kp R &kp S &kp T &kp G   &kp M &kp N  &kp E     &kp I   &kp O &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp D &kp V   &kp K &kp H  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI  &lt 2 SPACE  &lt 4 TAB   &lt 2 RET  &lt 1 BSPC  &lt 3 DEL
                        >;
                };
                num_layer {

                        display-name = "Num";
                        bindings = <
   &kp TAB   &kp STAR   &kp N7  &kp N8  &kp N9  &kp KP_PLUS       &kp N6   &kp N7    &kp N8     &kp N9    &kp N0  &trans
   &kp LCTRL &kp PRCNT  &kp N4  &kp N5  &kp N6  &kp KP_EQUAL      &trans   &kp CTRL  &kp SHIFT  &kp ALT   &trans  &trans
   &kp LSHFT &kp FSLH   &kp N1  &kp N2  &kp N3  &kp KP_MINUS      &kp N1   &kp N2    &kp N3     &kp N4    &kp N5  &trans
                  &trans     &kp N0     &trans           &kp RET  &trans    &kp RALT
                        >;
                };
                
                sym_layer {

                        display-name = "Sym";
                        bindings = <
   &kp TAB    &kp GRAVE   &kp LBKT     &kp AMP    &kp RBKT      &kp FSLH         &trans   &trans   &trans     &trans   &trans  &trans
   &kp LCTRL  &kp DOLLAR  &kp KP_LPAR  &kp EXCL   &kp KP_RPAR   &kp BSLH         &trans   &kp CTRL &kp SHIFT  &kp ALT  &trans  &trans
   &kp LSHFT  &kp POUND   &kp STAR     &kp AT     &kp PCT       &kp CARET        &trans   &trans   &trans     &trans   &trans  &trans
                  &kp MINUS     &kp EQUAL    &kp SEMI      &trans  &trans   &trans
                        >;
                };

                fun_layer {

                        display-name = "Fun";
                        bindings = <
   &kp TAB    &trans &kp F7   &kp F8   &kp F9   &kp F10         &trans  &trans    &trans     &trans   &trans  &trans
   &kp LCTRL  &trans &kp F4   &kp F5   &kp F6   &kp F11         &trans  &kp CTRL  &kp SHIFT  &kp ALT  &trans  &trans
   &kp LSHFT  &trans &kp F1   &kp F2   &kp F3   &kp F12         &trans  &trans    &trans     &trans   &trans  &trans
                  &trans     &trans    &trans      &trans  &trans   &trans
                        >;
                };

                nav_layer {

                        display-name = "Nav";
                        bindings = <
   &kp TAB  &kp N1   &kp N7  &kp N8  &kp N9  &kp N5         &trans   &HOME   &END &kp N9    &kp N0 &kp BSPC
   &trans &trans     &kp N4  &kp N5  &kp N6  &trans   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LSHFT &trans  &kp N1  &kp N2  &kp N3  &trans         &trans   &kp PG_DN   &kp PG_UP &trans    &trans &trans
                          	        &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                mouse_layer {
                        display-name = "Mouse";
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &mkp RCLK &mkp LCLK  &trans   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                    	     &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
